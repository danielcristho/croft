#!/bin/sh
set -e

MANIFEST=collector/Cargo.toml

# Rust checks run only when a staged change touches the collector.
if ! git diff --cached --name-only | grep -qE '^collector/'; then
  echo "✓ no collector changes"
  exit 0
fi

# rustfmt.toml opts into unstable options that stable rustfmt ignores.
if ! cargo +nightly fmt --manifest-path "$MANIFEST" --all -- --check > /dev/null; then
  echo "✗ rustfmt: unformatted files"
  echo "  Run: just fmt"
  exit 1
fi
echo "✓ rustfmt"

# Without bpf-linker the eBPF build is skipped; clippy and the tests still cover the userspace code.
PACKAGE=""
if ! command -v bpf-linker > /dev/null 2>&1; then
  export AYA_BUILD_SKIP=1
  PACKAGE="-p collector"
  echo "· eBPF build skipped: bpf-linker not found"
fi

cargo clippy --manifest-path "$MANIFEST" --quiet $PACKAGE -- -D warnings
echo "✓ clippy"

cargo test --manifest-path "$MANIFEST" --quiet $PACKAGE > /dev/null
echo "✓ tests"
