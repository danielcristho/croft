# Sample applications for the burst experiments: deploy, check, run and remove them.
# From the repository root: just samples <recipe> [args].

set dotenv-filename := ".local/env"

export KUBECONFIG := env_var_or_default("KUBECONFIG", env_var("HOME") + "/.kube/croft-k3s.yaml")

# The node that pins a run's pods: CROFT_NODE, from the environment or .local/env.
node := "${CROFT_NODE:?set CROFT_NODE to a node name from kubectl get nodes}"

# List available recipes.
list:
    @just --list

# The samples of apps.json: name, namespace, request URL.
apps:
    @python3 -m experiment.apps

# Load a local Docker image into every node's k3s. Asks for the sudo password.
load-image image:
    cd ../../k3s-cluster && ansible-playbook load-image.yml -e image={{ image }} --ask-become-pass

# Apply a sample's manifest and wait until every Deployment is Available.
deploy app:
    kubectl apply -f workloads/{{ app }}/k8s.yaml
    kubectl -n $(python3 -m experiment.apps {{ app }} namespace) wait --for=condition=Available deployment --all --timeout=600s

# Pods of a sample, with their node.
status app:
    kubectl -n $(python3 -m experiment.apps {{ app }} namespace) get pods -o wide

# One request on the sample's experiment path: status code and time.
smoke app:
    curl -s -o /dev/null -w "%{http_code} %{time_total}s\n" "$(python3 -m experiment.apps {{ app }} url)"

# The sample's request URL.
url app:
    @python3 -m experiment.apps {{ app }} url

# Restart every Deployment of a sample, e.g. to reseed hotel-reservation's MongoDB.
# Registries and stores go first: a service that starts before consul never registers.
restart app:
    #!/usr/bin/env bash
    set -euo pipefail
    ns=$(python3 -m experiment.apps {{ app }} namespace)
    all=$(kubectl -n "$ns" get deployment -o name)
    first=$(grep -E '/(consul|mongodb|memcached|astronomy-db|valkey|flagd|otel-collector)' <<<"$all" || true)
    rest=$(grep -v -E '/(consul|mongodb|memcached|astronomy-db|valkey|flagd|otel-collector)' <<<"$all" || true)
    for group in "$first" "$rest"; do
      [ -n "$group" ] || continue
      kubectl -n "$ns" rollout restart $group
      for d in $group; do kubectl -n "$ns" rollout status "$d" --timeout=600s; done
    done

# Delete a sample and its namespace.
remove app:
    kubectl delete -f workloads/{{ app }}/k8s.yaml --ignore-not-found

# One burst run, pinned to one node; arm is none (HPA) or croft. Lands in data/web/<prefix>-<arm>-burst.
burst app arm="none" prefix="try":
    uv run run.py web --app {{ app }} --node {{ node }} --prefix {{ prefix }}-{{ arm }} --profile burst --probes relaxed --scaler {{ arm }}

# Three repetitions of both arms, alternated, then the scores.
series app prefix:
    for i in 1 2 3; do \
      for arm in none croft; do \
        uv run run.py web --app {{ app }} --node {{ node }} --prefix {{ prefix }}-$arm-$i --profile burst --probes relaxed --scaler $arm || exit 1; \
      done; \
    done
    uv run run.py compare --prefix {{ prefix }}-none- {{ prefix }}-croft-

# Service-interaction study, step 1 (about 1 hour): checks, the proxy scrape, then per sample a --mesh smoke run and a one-pod ramp.
mesh-prepare:
    #!/usr/bin/env bash
    set -euo pipefail
    mkdir -p data/web
    exec > >(tee -a data/web/mesh-prepare.log) 2>&1
    echo "== mesh-prepare $(date -Is) at $(git rev-parse --short HEAD), node {{ node }}"
    kubectl get nodes
    ! kubectl get nodes --no-headers | awk '$2 !~ /^Ready/' | grep . || { echo "a node is not Ready"; exit 1; }
    kubectl top nodes
    command -v linkerd >/dev/null || { echo "install Linkerd and linkerd-viz first"; exit 1; }
    linkerd check --proxy=false
    viz=1; linkerd viz check || { viz=0; echo "linkerd viz is not healthy: skipping linkerd viz edges"; }
    kubectl apply -f workloads/linkerd/podmonitor.yaml
    for app in hotel-reservation online-boutique otel-demo; do
      ns=$(python3 -m experiment.apps "$app" namespace)
      echo "== $app: smoke run ($(date +%T))"
      uv run run.py web --app "$app" --node {{ node }} --prefix "$app-mesh-smoke" --profile constant --probes relaxed --mesh
      python3 -m experiment.interactions smoke "data/web/$app-mesh-smoke-constant"
      kubectl get hpa -n "$ns"
      [ "$viz" = 0 ] || linkerd viz edges deploy -n "$ns"
      echo "== $app: one-pod ramp ($(date +%T))"
      uv run run.py web --app "$app" --node {{ node }} --prefix "$app-mesh-cap" --profile ramp --replicas 1 --probes relaxed --mesh
    done
    python3 -m experiment.interactions capacity

# One meshed pod's capacity per sample from mesh-prepare's ramps, with suggested lo and hi scales.
mesh-capacity:
    @python3 -m experiment.interactions capacity

# Service-interaction study, step 2 (about 8.5 hours): 3 samples x burst, ramp x lo, hi x 3 repetitions under the HPA with --mesh.
# Stops at the first failed run; the same command again skips the recorded runs and resumes.
interactions hr_lo hr_hi ob_lo ob_hi otel_lo otel_hi:
    #!/usr/bin/env bash
    set -euo pipefail
    declare -A scale=([hotel-reservation-lo]={{ hr_lo }} [hotel-reservation-hi]={{ hr_hi }} [online-boutique-lo]={{ ob_lo }}
                      [online-boutique-hi]={{ ob_hi }} [otel-demo-lo]={{ otel_lo }} [otel-demo-hi]={{ otel_hi }})
    for v in "${scale[@]}"; do [[ $v =~ ^[0-9]*\.?[0-9]+$ ]] && awk "BEGIN{exit !($v > 0)}" || { echo "scale $v is not a positive number"; exit 1; }; done
    mkdir -p data/web
    exec > >(tee -a data/web/interactions.log) 2>&1
    echo "== interactions $(date -Is) at $(git rev-parse --short HEAD), node {{ node }}"
    { echo "$(date -Is) $(git rev-parse HEAD)"; for k in "${!scale[@]}"; do echo "  $k ${scale[$k]}"; done | sort; } | tee -a data/web/interactions-scales.txt
    ! kubectl get nodes --no-headers | awk '$2 !~ /^Ready/' | grep . || { echo "a node is not Ready"; exit 1; }
    linkerd check --proxy=false >/dev/null || { echo "linkerd check failed"; exit 1; }
    start=$SECONDS; k=0
    for i in 1 2 3; do for app in hotel-reservation online-boutique otel-demo; do for p in burst ramp; do for s in lo hi; do
      k=$((k + 1)); prefix=si-$app-$s-$i
      if [ -f data/web/runs.jsonl ] && grep -qF "\"run_id\": \"$prefix-$p\"" data/web/runs.jsonl; then echo "[$k/36] $prefix-$p recorded, skipping"; continue; fi
      echo "[$k/36] $prefix-$p --scale ${scale[$app-$s]} ($((( SECONDS - start) / 60)) min in, $(date +%T))"
      uv run run.py web --app "$app" --node {{ node }} --prefix "$prefix" --profile "$p" --scale "${scale[$app-$s]}" --probes relaxed --mesh \
        || { echo "FAILED: $prefix-$p. Fix the cause and rerun the same command to resume."; exit 1; }
    done; done; done; done
    echo "== done in $(((SECONDS - start) / 60)) min; $(find data/web -maxdepth 1 -type d \( -name 'si-*-burst' -o -name 'si-*-ramp' \) | wc -l) si-* runs (expect 36)"
    python3 -m experiment.interactions summary

# Acceptance columns of every service-interaction run: mesh, edges, backend restarts, ingress p95.
interactions-check:
    @python3 -m experiment.interactions summary

# Measure croft scale's calibration on one pinned pod at constant loads (about 5 minutes).
calibrate app levels="20 50 100" seconds="75":
    uv run run.py calibrate-scaler --app {{ app }} --node {{ node }} --levels {{ levels }} --seconds {{ seconds }}

# Apply the Grafana dashboard and the croft collector scrape it reads, then print its URL.
monitoring:
    kubectl apply -k workloads/monitoring
    @echo "http://grafana.127.0.0.1.sslip.io:30080/d/croft-experiment"

# Score finished burst runs by prefix; rows of other runs in compare.csv are kept.
compare +prefixes:
    uv run run.py compare --prefix {{ prefixes }}
