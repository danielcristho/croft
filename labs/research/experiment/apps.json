{
  "hotel-reservation": {
    "namespace": "hotel-res",
    "deployment": "frontend",
    "container": "frontend",
    "manifests": "workloads/hotel-reservation",
    "host": "http://hotel.127.0.0.1.sslip.io:30080",
    "path": "/hotels?inDate=2015-04-09&outDate=2015-04-10&lat=38.0235&lon=-122.095",
    "health": "/",
    "scaler": {
      "syscall": "write",
      "calls_per_request": 11.8,
      "cpu_per_request_ms": 6.18
    },
    "targets": {
      "rate" :{
        "container": "rate"
      }
    },
    "scale": 1,
    "services": {
      "frontend": {"role": "gateway", "language": "go"},
      "search": {"role": "business", "language": "go"},
      "geo": {"role": "business", "language": "go"},
      "profile": {"role": "business", "language": "go"},
      "rate": {"role": "business", "language": "go"},
      "recommendation": {"role": "business", "language": "go"},
      "user": {"role": "business", "language": "go"},
      "reservation": {"role": "business", "language": "go"},
      "mongodb-geo": {"role": "database", "language": "cpp"},
      "mongodb-profile": {"role": "database", "language": "cpp"},
      "mongodb-rate": {"role": "database", "language": "cpp"},
      "mongodb-recommendation": {"role": "database", "language": "cpp"},
      "mongodb-reservation": {"role": "database", "language": "cpp"},
      "mongodb-user": {"role": "database", "language": "cpp"},
      "memcached-profile": {"role": "cache", "language": "c"},
      "memcached-rate": {"role": "cache", "language": "c"},
      "memcached-reserve": {"role": "cache", "language": "c"},
      "consul": {"role": "support", "language": "go"},
      "jaeger": {"role": "support", "language": "go"}
    },
    "mix": {
      "endpoints": [
        {"name": "search", "weight": 60, "path": "/hotels?inDate=2015-04-09&outDate=2015-04-10&lat=38.0235&lon=-122.095"},
        {"name": "recommend", "weight": 39, "path": "/recommendations?require=rate&lat=38.0235&lon=-122.095"},
        {"name": "login", "weight": 0.5, "method": "POST", "path": "/user?username=Cornell_31&password=1111111111"},
        {"name": "reserve", "weight": 0.5, "method": "POST", "path": "/reservation?inDate=2015-04-09&outDate=2015-04-10&lat=38.0235&lon=-122.095&hotelId=1&customerName=Cornell_31&username=Cornell_31&password=1111111111&number=1"}
      ]
    }
  },
  "online-boutique": {
    "namespace": "boutique",
    "deployment": "frontend",
    "container": "server",
    "manifests": "workloads/online-boutique",
    "host": "http://boutique.127.0.0.1.sslip.io:30080",
    "path": "/",
    "health": "/_healthz",
    "scaler": {
      "syscall": "getpeername",
      "calls_per_request": 2.0,
      "cpu_per_request_ms": 3.26
    },
    "scale": 1,
    "services": {
      "frontend": {"role": "gateway", "language": "go"},
      "adservice": {"role": "business", "language": "java"},
      "cartservice": {"role": "business", "language": "csharp"},
      "checkoutservice": {"role": "business", "language": "go"},
      "currencyservice": {"role": "business", "language": "nodejs"},
      "emailservice": {"role": "business", "language": "python"},
      "paymentservice": {"role": "business", "language": "nodejs"},
      "productcatalogservice": {"role": "business", "language": "go"},
      "recommendationservice": {"role": "business", "language": "python"},
      "shippingservice": {"role": "business", "language": "go"},
      "redis-cart": {"role": "cache", "language": "c"}
    },
    "mix": {
      "users": 50,
      "endpoints": [
        {"name": "index", "weight": 1, "path": "/", "headers": {"Cookie": "shop_session-id=croft-{user}"}},
        {"name": "currency", "weight": 2, "method": "POST", "path": "/setCurrency", "body": "currency_code=EUR", "headers": {"Cookie": "shop_session-id=croft-{user}"}},
        {"name": "product", "weight": 10, "path": "/product/OLJCESPC7Z", "headers": {"Cookie": "shop_session-id=croft-{user}"}},
        {"name": "cart-add", "weight": 2, "method": "POST", "path": "/cart", "body": "product_id=OLJCESPC7Z&quantity=1", "headers": {"Cookie": "shop_session-id=croft-{user}"}},
        {"name": "cart", "weight": 3, "path": "/cart", "headers": {"Cookie": "shop_session-id=croft-{user}"}},
        {"name": "checkout", "weight": 1, "method": "POST", "path": "/cart/checkout", "body": "email=someone%40example.com&street_address=1600+Amphitheatre+Parkway&zip_code=94043&city=Mountain+View&state=CA&country=United+States&credit_card_number=4432801561520454&credit_card_expiration_month=1&credit_card_expiration_year=2039&credit_card_cvv=672", "headers": {"Cookie": "shop_session-id=croft-{user}"}}
      ]
    }
  },
