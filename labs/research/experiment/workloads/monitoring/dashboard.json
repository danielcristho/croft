{
  "uid": "croft-experiment",
  "title": "croft experiment: HPA and croft",
  "tags": [
    "croft"
  ],
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "schemaVersion": 39,
  "editable": true,
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Data source",
        "current": {
          "text": "Prometheus",
          "value": "prometheus"
        }
      },
      {
        "name": "namespace",
        "type": "custom",
        "label": "App",
        "query": "hotel-reservation : hotel-res,online-boutique : boutique,otel-demo : otel-demo",
        "current": {
          "text": "hotel-reservation",
          "value": "hotel-res"
        },
        "options": [
          {
            "text": "hotel-reservation",
            "value": "hotel-res",
            "selected": true
          },
          {
            "text": "online-boutique",
            "value": "boutique",
            "selected": false
          },
          {
            "text": "otel-demo",
            "value": "otel-demo",
            "selected": false
          }
        ]
      },
      {
        "name": "deployment",
        "type": "query",
        "label": "Deployment",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(kube_deployment_spec_replicas{namespace=\"$namespace\"}, deployment)",
          "refId": "D"
        },
        "definition": "label_values(kube_deployment_spec_replicas{namespace=\"$namespace\"}, deployment)",
        "regex": "/^frontend$/",
        "refresh": 1
      },
      {
        "name": "syscall",
        "type": "custom",
        "label": "croft syscall",
        "query": "write,writev,sendto",
        "current": {
          "text": "write",
          "value": "write"
        },
        "options": [
          {
            "text": "write",
            "value": "write",
            "selected": true
          },
          {
            "text": "writev",
            "value": "writev",
            "selected": false
          },
          {
            "text": "sendto",
            "value": "sendto",
            "selected": false
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Arm now",
      "description": "croft while a croft-scaler Deployment runs, HPA otherwise.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "(3 * count(kube_deployment_status_replicas_available{namespace=\"croft\",deployment=~\"croft-scaler-.*\"} > 0) or vector(0))",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "interval": "5s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "HPA",
                  "color": "#2a78d6",
                  "index": 0
                },
                "3": {
                  "text": "croft",
                  "color": "#1baf7a",
                  "index": 1
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Pods created in range",
      "description": "Frontend pods created inside the dashboard's time range. Set the range to one run.",
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count(max_over_time(kube_pod_created{namespace=\"$namespace\",pod=~\"$deployment-[a-z0-9]+-[a-z0-9]+\"}[$__range]) > ${__from:date:seconds}) or vector(0)",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "interval": "5s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Peak ready replicas in range",
      "description": "",
      "gridPos": {
        "x": 9,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max_over_time(kube_deployment_status_replicas_ready{namespace=\"$namespace\",deployment=\"$deployment\"}[$__range])",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "interval": "5s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Replica-seconds in range",
      "description": "The cost: replicas times seconds, sampled every 5 s.",
      "gridPos": {
        "x": 14,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum_over_time(kube_deployment_status_replicas{namespace=\"$namespace\",deployment=\"$deployment\"}[$__range:5s]) * 5",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "interval": "5s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 5,
      "type": "text",
      "title": "",
      "description": "",
      "gridPos": {
        "x": 19,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "mode": "markdown",
        "content": "Replica counts come from kube-state-metrics, scraped every 30 s: a pod can show up to 30 s late. Requests and croft's syscalls are scraped every 5 s."
      }
    },
    {
      "id": 6,
      "type": "state-timeline",
      "title": "Arm",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 3
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "(3 * count(kube_deployment_status_replicas_available{namespace=\"croft\",deployment=~\"croft-scaler-.*\"} > 0) or vector(0))",
          "legendFormat": "arm",
          "refId": "A",
          "instant": false,
          "range": true,
          "interval": "5s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "HPA",
                  "color": "#2a78d6",
                  "index": 0
                },
                "3": {
                  "text": "croft",
                  "color": "#1baf7a",
                  "index": 1
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "rowHeight": 0.8,
        "legend": {
          "showLegend": false
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Requests at the ingress",
      "description": "Requests per second the ingress completed, over 30 s.",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(nginx_ingress_controller_requests{exported_namespace=\"$namespace\",service=\"$deployment\",status=~\"2..\"}[30s]))",
          "legendFormat": "answered 2xx",
          "refId": "A",
          "instant": false,
          "range": true,
          "interval": "5s"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(nginx_ingress_controller_requests{exported_namespace=\"$namespace\",service=\"$deployment\",status!~\"2..\"}[30s]))",
          "legendFormat": "other status",
          "refId": "B",
          "instant": false,
          "range": true,
          "interval": "5s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "lineInterpolation": "linear",
            "spanNulls": true
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "p95 latency at the ingress",
      "description": "The dashed line is the 500 ms objective. The load generator's own p95 is in workload.csv.",
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(nginx_ingress_controller_request_duration_seconds_bucket{exported_namespace=\"$namespace\",service=\"$deployment\"}[30s])))",
          "legendFormat": "p95",
          "refId": "A",
          "instant": false,
          "range": true,
          "interval": "5s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "lineInterpolation": "linear",
            "spanNulls": true,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "#8a8984",
                "value": 0.5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Replicas",
      "description": "desired is what the Deployment asks for, set by the HPA or croft; ready is what serves.",
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "kube_deployment_spec_replicas{namespace=\"$namespace\",deployment=\"$deployment\"}",
          "legendFormat": "desired",
          "refId": "A",
          "instant": false,
          "range": true,
          "interval": "5s"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "kube_deployment_status_replicas_ready{namespace=\"$namespace\",deployment=\"$deployment\"}",
          "legendFormat": "ready",
          "refId": "B",
          "instant": false,
          "range": true,
          "interval": "5s"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(kube_horizontalpodautoscaler_status_desired_replicas{namespace=\"$namespace\",horizontalpodautoscaler=\"$deployment\"})",
          "legendFormat": "HPA wants",
          "refId": "C",
          "instant": false,
          "range": true,
          "interval": "5s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "lineInterpolation": "stepAfter",
            "spanNulls": true
          },
          "decimals": 0,
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "type": "state-timeline",
      "title": "Frontend pods",
      "description": "One row per pod: when it existed, and when it was Ready.",
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (pod) (kube_pod_status_ready{namespace=\"$namespace\",pod=~\"$deployment-[a-z0-9]+-[a-z0-9]+\",condition=\"true\"})",
          "legendFormat": "{{pod}}",
          "refId": "A",
          "instant": false,
          "range": true,
          "interval": "5s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "not ready",
                  "color": "#eda100",
                  "index": 0
                },
                "1": {
                  "text": "ready",
                  "color": "#1baf7a",
                  "index": 1
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "rowHeight": 0.8,
        "legend": {
          "showLegend": true
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "croft signal: syscalls per pod",
      "description": "The collector's rate of the calibrated syscall per frontend pod. Pick the app's syscall above: write for hotel-reservation, writev for otel-demo, the calibrated one for online-boutique.",
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (pod) (croft_container_syscall_rate{syscall=\"$syscall\"} * on (container_id) group_left (pod) label_replace(kube_pod_container_info{namespace=\"$namespace\",container=\"$deployment\"}, \"container_id\", \"$1\", \"container_id\", \"containerd://(.*)\"))",
          "legendFormat": "{{pod}}",
          "refId": "A",
          "instant": false,
          "range": true,
          "interval": "5s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "lineInterpolation": "linear",
            "spanNulls": true
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "CPU per pod",
      "description": "What the HPA scales on, from cAdvisor.",
      "gridPos": {
        "x": 12,
        "y": 23,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"$namespace\",pod=~\"$deployment-[a-z0-9]+-[a-z0-9]+\",container=\"$deployment\"}[1m]))",
          "legendFormat": "{{pod}}",
          "refId": "A",
          "instant": false,
          "range": true,
          "interval": "5s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "lineInterpolation": "linear",
            "spanNulls": true
          },
          "unit": "cores"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ]
}
