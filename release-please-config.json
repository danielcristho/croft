{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-component-in-tag": false,
  "bump-minor-pre-major": true,
  "packages": {
    ".": {
      "package-name": "croft",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        { "type": "toml", "path": "collector/Cargo.toml", "jsonpath": "$.workspace.package.version" },
        { "type": "generic", "path": "deploy/helm/croft/Chart.yaml" }
      ]
    }
  }
}
